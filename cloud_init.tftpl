#cloud-config
users:
  - name: ${baremetal_user}
    groups: [wheel]
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
    ssh_authorized_keys:
      - ${ssh_public_key}

# Set password and force change on first console login
chpasswd:
  expire: true
  list: |
    ${baremetal_user}:${baremetal_password}

# Keep SSH key-only — password only works on console
ssh_pwauth: false

package_update: true
package_upgrade: false

packages:
%{ for pkg in packages ~}
  - ${pkg}
%{ endfor ~}

%{ if syslog_host != "" ~}
write_files:
  - path: /etc/rsyslog.d/forward.conf
    permissions: '0644'
    content: |
      # Send all messages to remote syslog
      *.* @${syslog_host}:${syslog_port}
%{ endif ~}

runcmd:
  - dnf install -y sssd sssd-ldap sssd-tools oddjob-mkhomedir
  - authselect select sssd with-mkhomedir --force
%{ if syslog_host != "" ~}
  - systemctl enable --now rsyslog
%{ endif ~}
  - echo 'Jumpbox provisioned by terraform-deploy-openstack' > /etc/motd
  - echo 'Default password must be changed on first login.' >> /etc/motd
